{
  "manifest_version": 3,
  "name": "Sovereign Bilingual Reader",
  "version": "0.3.0",
  "description": "On-demand bilingual page translation with local Ollama, deepLocal, or optional OpenAI.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Sovereign Bilingual Reader",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "optional_host_permissions": [
    "https://api.openai.com/*"
  ]
}
