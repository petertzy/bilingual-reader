{
  "manifest_version": 3,
  "name": "Sovereign Bilingual Reader",
  "version": "0.5.0",
  "description": "On-demand bilingual page translation with local Ollama, deepLocal, or optional OpenAI.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://api.openai.com/*"
  ],
  "action": {
    "default_title": "Sovereign Bilingual Reader",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Translate selected text"
    },
    "toggle-quick-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Show or hide the floating translation tab"
    }
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
